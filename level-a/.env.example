# Copy to level-a/.env (gitignored) and fill in. Every process reads it: the
# API, the worker, the supervisor, the order systems, the scripts and the tests.
# Never commit real values; on a host, set them in its dashboard instead.

# ---- Atlas (required) ------------------------------------------------------
# Connection string for the Atlas sandbox cluster. For local development a
# single-node replica set works: mongodb://127.0.0.1:27017/?replicaSet=rs0
ATLAS_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
ATLAS_DB=levela

# ---- URLs --------------------------------------------------------------------
# How THIS process reaches the API. On the laptop: the public URL when the API
# is hosted (the worker's simulated calls go through it), else
# http://127.0.0.1:8000. On the API host itself: http://127.0.0.1:<its port>,
# because the API's simulator posts its replies back to the API.
API_BASE_URL=http://127.0.0.1:8000
# The public HTTPS URL ElevenLabs calls (Render/Fly/Railway, or a tunnel).
# Re-run scripts/provision_agent.py whenever it changes.
PUBLIC_BASE_URL=

# ---- Shared secrets (generate: python -c "import secrets;print(secrets.token_urlsafe(24))")
# A secret left empty refuses every request that needs it (fail closed).
TOOL_SECRET=
# The post-call webhook's signing secret (WEBHOOK_SECRET is read as an older name).
ELEVEN_WEBHOOK_SECRET=
ADMIN_TOKEN=
# Laptop-only runs: LEVELA_DEV=1 fills each secret left empty above with a
# public development value (dev-tool-secret, dev-webhook-secret,
# dev-admin-token), the same in every process that reads this file. Those
# values are in the repository and protect nothing: never set it on a host,
# and scripts/provision_agent.py refuses them.
# LEVELA_DEV=1

# ---- ElevenLabs Agents + Twilio ------------------------------------------
ELEVEN_API_KEY=
ELEVEN_AGENT_ID=
ELEVEN_PHONE_ID=
# Set after the first scripts/provision_agent.py run (it prints the value).
ELEVEN_WEBHOOK_ID=
# ELEVEN_BASE_URL=https://api.elevenlabs.io
TWILIO_SID=
TWILIO_TOKEN=
RINGING_TIMEOUT_S=20
# elevenlabs = ring real phones; sim = the simulator plays voice parties too
VOICE_PROVIDER=elevenlabs

# The two real calls in the demo, E.164. Never commit real numbers.
PHONE_HARBOUR=
PHONE_CORNER=

# ---- Embeddings ----------------------------------------------------------
# Leave EMBED_API_KEY empty to use the local hash embedder (256 dims).
# VOYAGE_API_KEY is read as an older name for EMBED_API_KEY.
# EMBED_PROVIDER=voyage
EMBED_API_KEY=
EMBED_MODEL=voyage-4
EMBED_BASE_URL=https://ai.mongodb.com/v1
# EMBED_DIMS=1024
MEMORY_ENABLED=true

# ---- Mock distributor order systems (V2 section 7) ------------------------------
# Where the API and the worker reach the two order systems (scripts/start_order_systems.sh
# starts them on these ports). When the API is hosted and the order systems run on
# the laptop, the HOST's values must be the order systems' tunnel URLs
# (deploy/README.md, "Order systems behind a tunnel").
ORDER_NORTH_URL=http://127.0.0.1:8101
ORDER_EAST_URL=http://127.0.0.1:8102

# ---- Decider, planner and order system repair (V2 sections 5 to 7) -----------------
# rules = deterministic ladder, no model calls (default). claude = the
# Anthropic Messages API (needs ANTHROPIC_API_KEY).
PLANNER=rules
PLANNER_MODEL=claude-haiku-5-5
# The order system repairer uses the model only when ANTHROPIC_API_KEY is set;
# without it the rules repairer matches openapi.json descriptions.
REPAIR_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---- API background scheduler (V2 section 10) ------------------------------
# Invariants once per simulated hour and scheduled order system changes. Only the
# API process runs it; set false to switch it off (tests do).
SCHEDULER_ENABLED=true

# ---- Tests ---------------------------------------------------------------
# The cluster tests run against (each test session uses a scratch database
# and drops it). LEVELA_TEST_CLUSTER=n picks LEVELA_TEST_URI_n instead, to
# spread parallel sessions over several free clusters (100 operations per
# second each). CI sets LEVELA_TEST_URI to its MongoDB service container.
LEVELA_TEST_URI=
# LEVELA_TEST_URI_1=
# LEVELA_TEST_URI_2=
# LEVELA_TEST_URI_3=
# LEVELA_TEST_CLUSTER=1

# ---- Worker tuning (defaults are right for the demo) ---------------------
# WORKER_NAME=worker-1
# LEASE_S=60
# LEASE_EXTEND_S=15
# A task run's time budget never ends before this many real seconds (fast clocks):
# RUN_MIN_REAL_S=20
# HEARTBEAT_S=2
# WORKER_DEAD_AFTER_S=8
# RECONCILE_EVERY_S=2
# INDOUBT_GRACE_S=15
# PROBE_SKEW_S=5
# STALE_CALL_S=120
# MAX_ATTEMPTS=3
# RETRY_BACKOFF_S=30
# SIM_TIME_SCALE=1.0
# Arms a failpoint from the environment for one worker run (scripts only):
# LEVELA_FAILPOINT=after_dial_request

# ---- Sub-recall between nodes (spec "Sub-recall, agent to agent") ---------
# This copy's name. Our node is maple-farm; Summit Foods' node is summit.
# NODE_ID=maple-farm
# Set on a child node only: the parent node's API.
# PARENT_URL=http://127.0.0.1:8000
# The HMAC secret shared by one pairing (never stored in Atlas).
# LINK_SECRET_<PEER> overrides it for one peer, e.g. LINK_SECRET_SUMMIT=...
# AGENT_LINK_SECRET=
# The second node (scripts/start_summit.sh): its database and port.
# MONGODB_DB=levela_summit
# PORT=8200
